# Copy to .env and fill in. Without IMMICH_* the page uses ./photos, then demo images.
IMMICH_URL=http://192.168.1.10:2283
# Needs the permissions asset.read and asset.view (plus album.read with IMMICH_ALBUM_ID)
IMMICH_API_KEY=
# Optional: only show photos from this album (ID from the album URL in Immich)
IMMICH_ALBUM_ID=
PORT=8787
